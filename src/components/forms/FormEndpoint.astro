---
// Connects the form it sits in to Trislab's shared form Worker (docs/forms.md).
// The same build runs in every Environment, but each has its own Worker and
// Turnstile widget, so the address and the site key are read in the browser
// from /config.json (PUBLIC_FORMS_URL, PUBLIC_TURNSTILE_SITE_KEY; set per
// GitHub Environment). With both, the form posts to
// `${PUBLIC_FORMS_URL}/f/${formId}`, the Turnstile widget is shown and the
// form's submit buttons are switched on. Without them (`pnpm dev`, the checks)
// nothing is loaded and the buttons stay off.
//
// - The site key is public. The secret key lives only on the Worker.
// - The page needs its own Content-Security-Policy rule in public/_headers
//   (docs/forms.md, section 3), and scripts/check-claims.mjs allows this
//   script only on a page with this component.
interface Props {
  /** The form's id on the form Worker, for example "strehanakljuc-povprasevanje". */
  formId: string;
  /** A name for the form, shown in Cloudflare's analytics. */
  action?: string;
  theme?: "auto" | "light" | "dark";
}

const { formId, action, theme = "auto" } = Astro.props;
---

<div class="cf-turnstile" data-form-endpoint={formId} data-action={action} data-theme={theme} hidden></div>

<script>
  import { loadConfig } from "../../lib/config";

  const TURNSTILE_SCRIPT = "https://challenges.cloudflare.com/turnstile/v0/api.js";

  const config = await loadConfig();
  const formsUrl = config.PUBLIC_FORMS_URL?.trim().replace(/\/+$/, "");
  const siteKey = config.PUBLIC_TURNSTILE_SITE_KEY?.trim();
  const widgets = document.querySelectorAll<HTMLElement>("[data-form-endpoint]");

  if (formsUrl?.startsWith("https://") && siteKey && widgets.length > 0) {
    widgets.forEach((widget) => {
      const form = widget.closest("form");
      if (!form) return;
      form.action = `${formsUrl}/f/${encodeURIComponent(widget.dataset.formEndpoint ?? "")}`;
      widget.dataset.sitekey = siteKey;
      widget.hidden = false;
      form.querySelectorAll<HTMLButtonElement>("button[type='submit']").forEach((button) => {
        button.disabled = false;
      });
    });
    const script = document.createElement("script");
    script.src = TURNSTILE_SCRIPT;
    script.async = true;
    script.defer = true;
    document.head.append(script);
  }
</script>
