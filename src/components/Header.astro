---
// The site's header on slate: the logo and name, the main menu and the quote
// request as a button. On a phone the links fold into a menu that opens
// without JavaScript (<details>); the desktop menu and the phone menu are two
// copies, and CSS shows exactly one, so only one is ever in the
// accessibility tree.
import { localizedPath, t, type Lang } from "../i18n";
import { isCurrent, menuLinks, QUOTE_PATH } from "../lib/navigation";
import site from "../site.config";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  path: string;
  available?: readonly Lang[];
}

const { lang, path, available } = Astro.props;
const links = menuLinks(lang);
const quoteCurrent = isCurrent(path, QUOTE_PATH);
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={localizedPath(lang)}>
      <Logo />
      <span>{site.name}</span>
    </a>
    <nav class="main-nav" aria-label={t(lang, "nav.main")}>
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={localizedPath(lang, href)} aria-current={isCurrent(path, href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="button" href={localizedPath(lang, QUOTE_PATH)} aria-current={quoteCurrent ? "page" : undefined}>{t(lang, "nav.quote")}</a>
    </nav>
    <details class="phone-menu">
      <summary>{t(lang, "nav.menu")}</summary>
      <nav aria-label={t(lang, "nav.main")}>
        <ul>
          {
            links.map(({ href, label }) => (
              <li>
                <a href={localizedPath(lang, href)} aria-current={isCurrent(path, href) ? "page" : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={localizedPath(lang, QUOTE_PATH)} aria-current={quoteCurrent ? "page" : undefined}>{t(lang, "nav.quote")}</a>
          </li>
        </ul>
      </nav>
    </details>
    <LanguageSwitch lang={lang} path={path} available={available} />
  </div>
</header>
