---
// The home page, top to bottom (docs/brief.md): the hero with the two
// journeys, the steps in short, what is included, the roof layers and the
// quote request.
import Checklist from "../../components/Checklist.astro";
import HeroRoof from "../../components/HeroRoof.astro";
import JourneyChooser from "../../components/JourneyChooser.astro";
import QuoteCta from "../../components/QuoteCta.astro";
import RoofLayers from "../../components/RoofLayers.astro";
import Timeline from "../../components/Timeline.astro";
import { languagePaths, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../site.config";
import { pageTexts } from "../../texts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { home } = pageTexts(lang);
---

<BaseLayout title={site.name} description={home.intro.description} lang={lang}>
  <section class="hero">
    <div class="wrap hero-row">
      <div class="hero-text">
        <p class="eyebrow">{home.intro.eyebrow}</p>
        <h1>{home.intro.title}</h1>
        <p class="lead">{home.intro.lead}</p>
        <JourneyChooser lang={lang} flatRoofLabel={home.flatRoofLink} />
      </div>
      <HeroRoof />
    </div>
  </section>
  <Timeline lang={lang} id="steps" heading={home.stepsHeading} lead={home.stepsLead} steps={home.steps} />
  <Checklist id="included" heading={home.includedHeading} lead={home.includedLead} items={home.included} />
  <RoofLayers lang={lang} heading={home.layersHeading} lead={home.layersLead} />
  <QuoteCta lang={lang} />
</BaseLayout>
